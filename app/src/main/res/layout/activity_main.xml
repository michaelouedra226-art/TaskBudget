<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TaskBudget" android:textSize="28sp" android:textStyle="bold" android:paddingBottom="24dp"/>

    <TextView android:id="@+id/balance_text" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="20sp" android:paddingBottom="32dp"/>

    <Button android:id="@+id/btn_tasks" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/tasks" android:padding="12dp"/>
    <Button android:id="@+id/btn_budget" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/budget" android:padding="12dp" android:layout_marginTop="8dp"/>
</LinearLayout>
