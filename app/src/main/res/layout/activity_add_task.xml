<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <EditText android:id="@+id/title_input" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/task_title"/>

    <EditText android:id="@+id/due_input" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/due_date"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/save_btn" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/save"/>
        <Button android:id="@+id/cancel_btn" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/cancel"/>
    </LinearLayout>
</LinearLayout>
