<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/budget" android:textSize="20sp" android:textStyle="bold" android:padding="16dp"/>

    <TextView android:id="@+id/balance_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="18sp" android:padding="16dp"/>

    <ListView android:id="@+id/tx_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>

    <TextView android:id="@+id/empty_tx" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:padding="24dp"
        android:text="@string/no_transactions"/>

    <Button android:id="@+id/add_tx_btn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/add_transaction"/>
</LinearLayout>
